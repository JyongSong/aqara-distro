<?xml version="1.0" encoding="UTF-8"?>
<!--
  매일 한국시간 11:30 에 Supabase 백업을 로컬로 내린다.
  이 맥의 시스템 시간대가 Asia/Seoul 이므로 launchd 의 Hour/Minute 이 곧 한국시간이다.

  설치:
    cp scripts/launchd/com.aqara.distro.backup.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.aqara.distro.backup.plist
  설치 후 반드시 한 번 시험 실행 — PATH/cwd 문제는 launchd 환경에서만 드러난다:
    launchctl kickstart -p gui/$(id -u)/com.aqara.distro.backup
    launchctl print gui/$(id -u)/com.aqara.distro.backup | grep -E "last exit|runs ="
  제거:
    launchctl bootout gui/$(id -u)/com.aqara.distro.backup

  동작: 시각에 맥이 자고 있으면 다음에 깨어날 때 한 번만 따라잡아 실행한다
        (밀린 여러 회를 몰아서 돌리지 않는다). 전원이 꺼져 있으면 그 회차는 건너뛴다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aqara.distro.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zhiyongsong/aqara-distro/scripts/backup-db.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/zhiyongsong/aqara-distro</string>

  <!-- launchd 는 로그인 셸의 PATH 를 물려받지 않는다. node / brew 경로를 명시해야 한다. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>11</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/zhiyongsong/data_backup/aqara-distro/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zhiyongsong/data_backup/aqara-distro/backup.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
